# Servidor y entorno
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=higea
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_DIALECT=mysql

# Seguridad JWT y Bcrypt
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Proveedor de IA (gemini | openai | mock)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=your_ai_provider_api_key
AI_TIMEOUT_MS=15000

# API Externa Banco Central de Costa Rica (BCCR)
# Registrarse en https://www.bccr.fi.cr/indicadores-economicos/servicio-web
BCCR_EMAIL=your_registered_bccr_email@example.com
BCCR_TOKEN=your_bccr_token_here
BCCR_BASE_URL=https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx
BCCR_TIMEOUT_MS=8000

# Webhooks n8n
N8N_WEBHOOK_ONBOARDING_URL=http://localhost:5678/webhook/higea-onboarding
N8N_WEBHOOK_DELETION_URL=http://localhost:5678/webhook/higea-data-deletion
N8N_WEBHOOK_SECRET=replace_with_shared_webhook_secret
